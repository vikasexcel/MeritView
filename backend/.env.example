PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/meritview
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# URL of the frontend app (used in invitation email links)
APP_URL=http://localhost:5173

# SMTP settings for Nodemailer (e.g. Gmail: smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MeritView <your@gmail.com>

# OpenRouter API key for AI brief assistant (Phase 5)
OPENROUTER_API_KEY=
